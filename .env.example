# Copy to .env and fill in. Never commit .env: it holds the database credentials.

# Pooled connection, used by the app's Prisma client at runtime (src/db/client.ts).
DATABASE_URL=

# Direct connection, used by migrations and the seed (prisma.config.ts, npm run db:seed).
# Locally, it may be the same database as DATABASE_URL.
DIRECT_URL=

# Password of the whole app. Leave empty in local development: nothing is protected then.
APP_PASSWORD=

# Signs the lw_uid cookie that tells players apart (src/auth/current-user.ts). Required: the server refuses to
# start without it. Changing it forgets every anonymous player. A different value per environment, generated with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Sign-in with Google (Auth.js, src/auth/auth.ts), which also signs its session cookie with AUTH_SECRET. An OAuth
# client of type "Web application" in Google Cloud Console (APIs & Services > Credentials,
# https://console.cloud.google.com/apis/credentials), with this authorised redirect URI per environment:
#   <site address>/api/auth/callback/google   (locally http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The administrator's Google account: signing in with it attaches the inherited saves (from before owners) to it.
# Compared without case. Empty: nobody is the administrator.
ADMIN_EMAIL=

# Outside Vercel, in production, Auth.js trusts the request's host only with one of these (see authjs.dev):
# AUTH_URL=https://www.latewinner.app  or  AUTH_TRUST_HOST=true

# Club names shown in the game (src/engine/club-name.ts), read once when the server starts:
# real (default, also when empty) for the names of the world, fictional for neutral names from
# prisma/seed/data/club-aliases-fallback.json (a city or region and a plain word).
CLUB_NAMES=

# End-to-end tests (Playwright) read DATABASE_URL_TEST from a separate .env.test, never from this file.
