// Career Manager — schéma initial
// Deux familles de tables : référence (monde, issu d'OpenFootball, immuable)
// et partie (état évolutif d'une carrière, toujours scopé par saveId).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- RÉFÉRENCE

model Competition {
  id            String          @id @default(cuid())
  code          String          @unique // code OpenFootball, ex. "en.1"
  name          String
  country       String
  tier          Int             @default(1) // 1 ou 2 pour un championnat, 0 pour une coupe
  kind          CompetitionKind @default(LEAGUE) // championnat ou coupe nationale ("xx.cup") : les lecteurs de championnat filtrent LEAGUE
  clubs         Club[]
  clubSaves     ClubSave[]
  seasons       Season[]
  seasonResults SeasonResult[]
}

model Club {
  id             String       @id @default(cuid())
  slug           String       @unique // normalisé depuis le nom OpenFootball
  name           String
  shortName      String?
  country        String
  city           String?
  stadium        String?
  founded        Int?
  initialRank    Int // classement final de la saison source (2024-25) dans sa compétition, calculé par le seed depuis les scores
  primaryColor   String       @default("#737373") // couleur traditionnelle principale, #RRGGBB ; gris neutre par défaut
  secondaryColor String       @default("#D4D4D4") // couleur traditionnelle secondaire, #RRGGBB
  competition    Competition? @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  competitionId  String?
  initialPlayers Player[]
  clubSaves      ClubSave[]
  challenges     Challenge[]

  @@index([competitionId])
}

// Monde du seed (clubs de la saison source 2024-25, âges comptés au départ des parties, en 2026-27), généré par le
// seed avec une graine fixe. L'identité est copiée dans PlayerSave à la création de partie : le jeu ne lit jamais
// Player pour connaître un joueur. Sans club initial, le joueur fait partie du vivier de joueurs libres ; PostgreSQL ne compare pas les NULL dans l'unicité : le seed garantit celle du vivier.
model Player {
  id            String       @id @default(cuid())
  initialClub   Club?        @relation(fields: [initialClubId], references: [id], onDelete: Restrict)
  initialClubId String? // club dans le monde du seed, null = vivier de joueurs libres ; le club en cours de partie est porté par PlayerSave
  squadSlot     Int // 1–23 dans un club, 1–120 dans le vivier : avec initialClubId, identité stable (clé du seed et des graines d'attributs)
  firstName     String
  lastName      String
  birthDate     DateTime
  nationality   String
  position      Position
  playerSaves   PlayerSave[]

  @@unique([initialClubId, squadSlot])
}

// ------------------------------------------------------------------- PARTIE
// Supprimer une partie passe par la cascade depuis Save. PostgreSQL vérifie Restrict et même NoAction à
// chaque étape interne de cette cascade : MatchEvent et Transfer, qui référencent PlayerSave, sont donc en
// Cascade vers PlayerSave, sans quoi une partie jouée ne pourrait pas être supprimée.

// ---------------------------------------------------------------- COMPTES
// Un joueur du site. ANONYMOUS : reconnu par le cookie lw_uid, sans compte ; REGISTERED : compte (session suivante).
// Supprimer un User emporte ses parties (cascade) ; seuls la purge et les tests suppriment des User.

model User {
  id               String           @id @default(cuid())
  kind             UserKind
  createdAt        DateTime         @default(now())
  lastSeenAt       DateTime // mis à jour au plus une fois par jour (src/auth/current-user.ts), pour la purge
  email            String?          @unique // compte Google (src/auth/google.ts) ; null pour un utilisateur anonyme
  name             String? // nom du compte Google, mis à jour à chaque connexion
  image            String? // avatar du compte Google, mis à jour à chaque connexion
  googleSub        String?          @unique // identifiant stable du compte Google (claim « sub »)
  saves            Save[]
  days             UserDay[]
  challengeEntries ChallengeEntry[]
}

// Un jour où l'utilisateur est venu : écrit au même endroit que lastSeenAt, au plus une fois par jour, pour la
// rétention (/admin/stats). Supprimé avec l'utilisateur.
model UserDay {
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  day    DateTime @db.Date // jour UTC

  @@id([userId, day])
}

model Save {
  id             String              @id @default(cuid())
  owner          User?               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String? // null = partie « héritée », d'avant les propriétaires, rattachée plus tard au compte administrateur
  name           String
  managerName    String
  seed           String // graine de tout l'aléatoire de la partie
  worldVersion   Int // monde de la partie : 1 = premières divisions seules (parties d'avant les deuxièmes), 2 = premières et deuxièmes divisions ; sans défaut, createSave le donne toujours
  currentDate    DateTime // date "en jeu", jamais l'horloge système
  liveFixtureId  String? // match du club dirigé en suspens à la mi-temps ; sans clé étrangère, pour ne pas croiser la cascade depuis Save
  challenge      Challenge?          @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  challengeId    String? // partie du défi de la semaine (graine, club et nom imposés, hors des limites de parties, purgée 24 h après la fin du défi) ; null pour une partie normale
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  clubSaves      ClubSave[]
  playerSaves    PlayerSave[]
  seasons        Season[]
  fixtures       Fixture[]
  transfers      Transfer[]
  stats          PlayerSeasonStats[]
  seasonResults  SeasonResult[]
  challengeEntry ChallengeEntry?

  @@index([ownerId])
  @@index([challengeId])
}

model Season {
  id            String              @id @default(cuid())
  save          Save                @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId        String
  competition   Competition         @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  competitionId String
  startYear     Int // 2026 pour la saison 2026/27
  completed     Boolean             @default(false)
  movements     Json? // montées et descentes à la fin de la saison, clubs quittant cette compétition (src/db/promotion.ts, validé par Zod) ; null dans une partie worldVersion 1 et pour une saison en cours
  fixtures      Fixture[]
  stats         PlayerSeasonStats[]
  results       SeasonResult[] // au plus une : @@unique([saveId, seasonId])

  @@unique([saveId, competitionId, startYear])
  @@index([saveId])
}

model ClubSave {
  id              String       @id @default(cuid())
  save            Save         @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId          String
  club            Club         @relation(fields: [clubId], references: [id], onDelete: Restrict)
  clubId          String
  competition     Competition  @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  competitionId   String // compétition actuelle du club dans la partie, Club.competitionId à la création ; une saison passée lit ses clubs dans ses Fixture
  isManaged       Boolean      @default(false) // le club dirigé par le joueur
  budget          Int          @default(0) // euros
  wageBudget      Int          @default(0) // euros par saison
  reputation      Int          @default(50) // 1–99
  boardConfidence Int          @default(50) // 1–99
  formation       String       @default("4-3-3") // dispositif, l'un de FORMATION_NAMES (src/engine/formations.ts)
  lineup          Json? // composition enregistrée du club dirigé : { starters: [{ slot, playerKey }], benchOrder }
  players         PlayerSave[]
  homeFixtures    Fixture[]    @relation("HomeFixtures")
  awayFixtures    Fixture[]    @relation("AwayFixtures")
  wonFixtures     Fixture[]    @relation("WonFixtures")

  @@unique([saveId, clubId])
  @@index([saveId])
  @@index([saveId, competitionId])
}

model PlayerSave {
  id            String              @id @default(cuid())
  save          Save                @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId        String
  player        Player?             @relation(fields: [playerId], references: [id], onDelete: Restrict)
  playerId      String? // origine dans le monde du seed ; null pour un jeune arrivé en cours de partie
  playerKey     String // clé stable dans la partie : "olympique-lyonnais#5", "youth:2027:olympique-lyonnais:1"
  firstName     String // identité copiée depuis Player à la création de partie, ou tirée pour un jeune
  lastName      String
  birthDate     DateTime
  nationality   String
  position      Position
  clubSave      ClubSave?           @relation(fields: [clubSaveId], references: [id], onDelete: NoAction)
  clubSaveId    String? // null = joueur libre ou retraité
  overall       Int // 1–99, note courante
  potential     Int // 1–99, plafond estimé
  pace          Int
  shooting      Int
  passing       Int
  dribbling     Int
  defending     Int
  physical      Int
  goalkeeping   Int                 @default(1)
  form          Int                 @default(50) // 1–99
  morale        Int                 @default(50) // 1–99
  fitness       Int                 @default(100) // 0–100
  injuredUntil  DateTime?
  marketValue   Int                 @default(0) // euros
  wage          Int                 @default(0) // euros par saison
  contractUntil DateTime?
  stats         PlayerSeasonStats[]
  transfers     Transfer[]
  events        MatchEvent[]        @relation("MatchEventPlayer")
  relatedEvents MatchEvent[]        @relation("MatchEventRelatedPlayer")

  @@unique([saveId, playerId])
  @@unique([saveId, playerKey])
  @@index([saveId, clubSaveId])
}

model Fixture {
  id                String        @id @default(cuid())
  save              Save          @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId            String
  season            Season        @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId          String
  round             Int // numéro de journée ; en coupe, le tour : 1 préliminaire, 2 seizièmes … 6 finale
  scheduledAt       DateTime
  homeClubSave      ClubSave      @relation("HomeFixtures", fields: [homeClubSaveId], references: [id], onDelete: Cascade)
  homeClubSaveId    String
  awayClubSave      ClubSave      @relation("AwayFixtures", fields: [awayClubSaveId], references: [id], onDelete: Cascade)
  awayClubSaveId    String
  played            Boolean       @default(false) // vrai si et seulement si status = PLAYED : un match en suspens n'est pas joué
  status            FixtureStatus @default(SCHEDULED)
  homeGoals         Int? // score final, null tant que le match n'est pas PLAYED
  awayGoals         Int?
  homeHalfTimeGoals Int? // score de mi-temps ; null pour les matchs joués avant le moteur en deux périodes
  awayHalfTimeGoals Int?
  decidedBy         DecidedBy? // match de coupe joué : en 90 minutes, en prolongation ou aux tirs au but ; null en championnat
  homePenalties     Int? // tirs au but réussis, seulement si decidedBy = PENALTIES
  awayPenalties     Int?
  winnerClubSave    ClubSave?     @relation("WonFixtures", fields: [winnerClubSaveId], references: [id], onDelete: Cascade)
  winnerClubSaveId  String? // qualifié d'un match de coupe joué ; null en championnat
  liveState         Json? // état du moteur pendant HALF_TIME ou REGULATION_END (validé par Zod, src/db/live-state.ts), null sinon
  events            MatchEvent[]

  @@index([saveId, seasonId, round])
  @@index([saveId, scheduledAt])
}

model MatchEvent {
  id                  String         @id @default(cuid())
  fixture             Fixture        @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  fixtureId           String
  minute              Int // 1–90 (+ arrêts de jeu), 91–120 en prolongation ; numéro du tir pendant la séance
  period              EventPeriod    @default(REGULAR) // la minute 92 est un arrêt de jeu en REGULAR, une minute de prolongation en EXTRA_TIME
  type                MatchEventType
  side                MatchSide // équipe de l'événement, fixée au match : le club du joueur peut changer ensuite
  playerSave          PlayerSave?    @relation("MatchEventPlayer", fields: [playerSaveId], references: [id], onDelete: Cascade)
  playerSaveId        String? // buteur, joueur averti ou blessé, entrant d'un remplacement
  relatedPlayerSave   PlayerSave?    @relation("MatchEventRelatedPlayer", fields: [relatedPlayerSaveId], references: [id], onDelete: Cascade)
  relatedPlayerSaveId String? // passeur d'un but, sortant d'un remplacement

  @@index([fixtureId])
  @@index([playerSaveId])
  @@index([relatedPlayerSaveId])
}

model Transfer {
  id           String       @id @default(cuid())
  save         Save         @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId       String
  playerSave   PlayerSave   @relation(fields: [playerSaveId], references: [id], onDelete: Cascade)
  playerSaveId String
  fromClubId   String? // Club.id ; null = joueur libre ou club hors périmètre
  toClubId     String? // Club.id ; null = fin de carrière
  fee          Int          @default(0) // euros
  type         TransferType
  date         DateTime

  @@index([saveId, date])
}

model PlayerSeasonStats {
  id           String     @id @default(cuid())
  save         Save       @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId       String
  season       Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId     String
  playerSave   PlayerSave @relation(fields: [playerSaveId], references: [id], onDelete: Cascade)
  playerSaveId String
  appearances  Int        @default(0)
  minutes      Int        @default(0)
  goals        Int        @default(0)
  assists      Int        @default(0)
  yellowCards  Int        @default(0)
  redCards     Int        @default(0)

  @@unique([saveId, seasonId, playerSaveId])
  @@index([saveId, seasonId])
}

// Palmarès : le bilan du club dirigé dans une saison terminée de sa compétition, écrit par advanceToNextSeason avant
// le changement de saison (src/db/season-results.ts). Une saison terminée avant cette table est reconstruite à la
// première lecture, une fois. En Cascade vers Season, comme Fixture : la cascade depuis Save supprime Season avant
// d'atteindre cette table, et PostgreSQL vérifierait Restrict à cette étape.
model SeasonResult {
  id                 String      @id @default(cuid())
  save               Save        @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId             String
  season             Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId           String
  competition        Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  competitionId      String
  rank               Int
  points             Int
  played             Int
  won                Int
  drawn              Int
  lost               Int
  goalsFor           Int
  goalsAgainst       Int
  trophies           String[] // « champion » si rank = 1, « cup » pour la coupe gagnée
  cupRound           Int? // dernier tour de coupe joué (1 préliminaire … 6 finale) ; null sans coupe cette saison
  promoted           Boolean     @default(false) // monté en première division à la fin de la saison ; false pour une ligne reconstruite
  relegated          Boolean     @default(false) // descendu en deuxième division à la fin de la saison ; false pour une ligne reconstruite
  bestPlayerKey      String? // PlayerSave.playerKey ; null si aucun joueur n'a joué BEST_PLAYER_MIN_APPEARANCES matchs
  bestPlayerName     String? // prénom et nom
  bestPlayerPosition Position?
  bestPlayerGoals    Int?
  bestPlayerAssists  Int?
  bestPlayerRating   Float? // note de saison sur 10, une décimale (seasonRating, src/engine/season-result.ts)
  formation          String // dispositif du club dirigé à la fin de la saison
  createdAt          DateTime    @default(now())

  @@unique([saveId, seasonId])
}

// --------------------------------------------------------------------- DÉFI
// Le défi de la semaine : une graine et un club communs à toutes ses parties. Ni référence ni partie : écrit une fois
// par ensureChallenge (src/db/challenge.ts : route de maintenance du lundi, ou premier chargement de /challenge), jamais
// modifié ni supprimé. Ouvert tant que startsAt ≤ maintenant < endsAt : pas de statut stocké.

model Challenge {
  id               String           @id @default(cuid())
  weekKey          String           @unique // semaine ISO 8601 en UTC, « 2026-W45 » (src/lib/iso-week.ts)
  seed             String // graine de ses parties, HMAC de weekKey (src/lib/challenge-seed.ts) : jamais affichée
  club             Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  clubId           String // club imposé, tiré par drawChallengeClub (src/engine/challenge.ts)
  horizonMatchdays Int // journées de championnat du club qui comptent
  startsAt         DateTime // lundi 00:00 UTC de la semaine
  endsAt           DateTime // lundi suivant 00:00 UTC : une entrée soumise ensuite ne compte pas
  createdAt        DateTime         @default(now())
  saves            Save[]
  entries          ChallengeEntry[]
}

// La participation d'un utilisateur à un défi, une par semaine : créée avec sa partie (createChallengeSave), gardée
// quand la partie est supprimée (saveId à NULL), pour que le classement survive à la purge et qu'on ne recommence pas en
// supprimant sa partie. Score écrit une seule fois, quand le club a joué horizonMatchdays journées de championnat
// (recordChallengeScore) : null jusque-là. Supprimée avec l'utilisateur ; suit la partie à la fusion d'un anonyme.
model ChallengeEntry {
  id              String    @id @default(cuid())
  challenge       Challenge @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  challengeId     String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  save            Save?     @relation(fields: [saveId], references: [id], onDelete: SetNull)
  saveId          String?   @unique // null une fois la partie supprimée, par le joueur ou par la purge
  matchdaysPlayed Int       @default(0) // journées de championnat jouées par le club, jusqu'à horizonMatchdays
  points          Int? // des horizonMatchdays premières journées ; null tant que l'entrée n'est pas soumise
  goalDiff        Int?
  goalsFor        Int?
  submittedAt     DateTime? // heure réelle (UTC) de la soumission : date limite et dernier départage
  createdAt       DateTime  @default(now())

  @@unique([challengeId, userId])
  @@index([userId])
}

// -------------------------------------------------------------------- ENUMS

// Postes précis ; le groupe (GK, DF, MF, FW) se déduit du poste : positionGroup, src/engine/positions.ts.
enum Position {
  GK
  RB
  CB
  LB
  CDM
  CM
  CAM
  RM
  LM
  RW
  LW
  ST
}

enum UserKind {
  ANONYMOUS
  REGISTERED
}

enum FixtureStatus {
  SCHEDULED
  HALF_TIME // première période jouée, le match du club dirigé attend la seconde (Save.liveFixtureId)
  REGULATION_END // match de coupe du club dirigé à égalité après 90 minutes : il attend la prolongation (Save.liveFixtureId)
  PLAYED
}

enum MatchEventType {
  GOAL
  YELLOW_CARD
  RED_CARD
  INJURY
  SUBSTITUTION
  SHOOTOUT_GOAL // tir au but réussi : playerSaveId le tireur, relatedPlayerSaveId le gardien
  SHOOTOUT_MISS
}

enum EventPeriod {
  REGULAR
  EXTRA_TIME
  SHOOTOUT
}

enum CompetitionKind {
  LEAGUE
  CUP
}

enum DecidedBy {
  REGULATION
  EXTRA_TIME
  PENALTIES
}

enum MatchSide {
  HOME
  AWAY
}

enum TransferType {
  TRANSFER
  LOAN
  FREE
  RETIREMENT
}
