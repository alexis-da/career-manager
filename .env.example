# Copy to .env and fill in. Never commit .env: it holds the database credentials.

# Development runs on a local PostgreSQL (17, port 5432), never on Neon: create the databases with
# npm run db:local:init, then npx prisma migrate deploy and npm run db:seed. A password with special characters is
# written percent-encoded. Every local command refuses a database that is not on localhost (src/db/database-url.ts),
# unless ALLOW_REMOTE_DB=1. On Vercel, both variables point to Neon (production), set in the project's settings.

# Used by the app's Prisma client at runtime (src/db/client.ts); on Vercel, Neon's pooled connection.
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/latewinner_dev"

# Used by migrations and the seed (prisma.config.ts, npm run db:seed); locally the same database as DATABASE_URL, on
# Vercel Neon's direct connection.
DIRECT_URL="postgresql://postgres:<password>@localhost:5432/latewinner_dev"

# No longer used (until 24 October 2026, development and tests ran on the Neon « test » branch, sparkling-darkness,
# whose compute shared the free plan's quota with production):
# DATABASE_URL="postgresql://neondb_owner:<password>@ep-sparkling-darkness-zaojh4wr-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# DIRECT_URL="postgresql://neondb_owner:<password>@ep-sparkling-darkness-zaojh4wr.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Optional « closed » mode: set, the whole app asks for this password (proxy.ts, /login). Empty, the game is open to
# everyone, as in production since the access was opened.
APP_PASSWORD=

# Signs the lw_uid cookie that tells players apart (src/auth/current-user.ts). Required: the server refuses to
# start without it. Changing it forgets every anonymous player. A different value per environment, generated with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Sign-in with Google (Auth.js, src/auth/auth.ts), which also signs its session cookie with AUTH_SECRET. An OAuth
# client of type "Web application" in Google Cloud Console (APIs & Services > Credentials,
# https://console.cloud.google.com/apis/credentials), with this authorised redirect URI per environment:
#   <site address>/api/auth/callback/google   (locally http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The administrator's Google account: signing in with it attaches the inherited saves (from before owners) to it, and
# only it opens /admin/stats. Compared without case. Empty: nobody is the administrator.
ADMIN_EMAIL=

# Secret of the maintenance endpoint, POST /api/maintenance/purge (the daily purge of anonymous users), sent as
# « Authorization: Bearer <secret> » by .github/workflows/maintenance.yml (GitHub secret MAINTENANCE_SECRET, same value).
# Empty: the endpoint answers 404. Generate one as AUTH_SECRET.
MAINTENANCE_SECRET=

# Outside Vercel, in production, Auth.js trusts the request's host only with one of these (see authjs.dev):
# AUTH_URL=https://www.latewinner.app  or  AUTH_TRUST_HOST=true

# Club names shown in the game (src/engine/club-name.ts), read once when the server starts:
# real (default, also when empty) for the names of the world, fictional for neutral names from
# prisma/seed/data/club-aliases-fallback.json (a city or region and a plain word).
CLUB_NAMES=

# The tests read DATABASE_URL_TEST from a separate .env.test, never from this file: the end-to-end tests (Playwright)
# and the database tests (Vitest), on the local test database, with an AUTH_SECRET of their own:
#   DATABASE_URL_TEST="postgresql://postgres:<password>@localhost:5432/latewinner_test"
# No longer used: DATABASE_URL_TEST on the Neon test branch (sparkling-darkness), as DATABASE_URL above.
