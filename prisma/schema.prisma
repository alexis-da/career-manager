// Career Manager — schéma initial
// Deux familles de tables : référence (monde, issu d'OpenFootball, immuable)
// et partie (état évolutif d'une carrière, toujours scopé par saveId).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- RÉFÉRENCE

model Competition {
  id            String          @id @default(cuid())
  code          String          @unique // code OpenFootball, ex. "en.1"
  name          String
  country       String
  tier          Int             @default(1) // 1 ou 2 pour un championnat, 0 pour une coupe
  kind          CompetitionKind @default(LEAGUE) // championnat ou coupe nationale ("xx.cup") : les lecteurs de championnat filtrent LEAGUE
  clubs         Club[]
  clubSaves     ClubSave[]
  seasons       Season[]
  seasonResults SeasonResult[]
}

model Club {
  id             String       @id @default(cuid())
  slug           String       @unique // normalisé depuis le nom OpenFootball
  name           String
  shortName      String?
  country        String
  city           String?
  stadium        String?
  founded        Int?
  initialRank    Int // classement final de la saison source (2024-25) dans sa compétition, calculé par le seed depuis les scores
  primaryColor   String       @default("#737373") // couleur traditionnelle principale, #RRGGBB ; gris neutre par défaut
  secondaryColor String       @default("#D4D4D4") // couleur traditionnelle secondaire, #RRGGBB
  competition    Competition? @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  competitionId  String?
  initialPlayers Player[]
  clubSaves      ClubSave[]
  challenges     Challenge[]

  @@index([competitionId])
}

// Monde du seed (clubs de la saison source 2024-25, âges comptés au départ des parties, en 2026-27), généré par le
// seed avec une graine fixe. L'identité est copiée dans PlayerSave à la création de partie : le jeu ne lit jamais
// Player pour connaître un joueur. Sans club initial, le joueur fait partie du vivier de joueurs libres ; PostgreSQL ne compare pas les NULL dans l'unicité : le seed garantit celle du vivier.
model Player {
  id            String   @id @default(cuid())
  initialClub   Club?    @relation(fields: [initialClubId], references: [id], onDelete: Restrict)
  initialClubId String? // club dans le monde du seed, null = vivier de joueurs libres ; le club en cours de partie est porté par PlayerSave
  squadSlot     Int // 1–23 dans un club, 1–120 dans le vivier : avec initialClubId, identité stable (clé du seed et des graines d'attributs)
  firstName     String
  lastName      String
  birthDate     DateTime
  nationality   String
  position      Position

  @@unique([initialClubId, squadSlot])
}

// ------------------------------------------------------------------- PARTIE
// Supprimer une partie passe par la cascade depuis Save. PostgreSQL vérifie Restrict et même NoAction à
// chaque étape interne de cette cascade : MatchEvent et Transfer, qui référencent PlayerSave, sont donc en
// Cascade vers PlayerSave, sans quoi une partie jouée ne pourrait pas être supprimée.
// Chaque clé étrangère de cette cascade a un index qui commence par sa colonne : PostgreSQL l'applique ligne par
// ligne, une requête par ligne supprimée (PlayerSave, ClubSave, Season…), et sans index chacune parcourt toute la
// table, les autres parties comprises (une partie à deux divisions se supprimait en 30 s, contre 0,5 s avec ces index).

// ---------------------------------------------------------------- COMPTES
// Un joueur du site. ANONYMOUS : reconnu par le cookie lw_uid, sans compte ; REGISTERED : compte (session suivante).
// Supprimer un User emporte ses parties (cascade) ; seuls la purge et les tests suppriment des User.

model User {
  id               String           @id @default(cuid())
  kind             UserKind
  createdAt        DateTime         @default(now())
  lastSeenAt       DateTime // mis à jour au plus une fois par jour (src/auth/current-user.ts), pour la purge
  email            String?          @unique // compte Google (src/auth/google.ts) ; null pour un utilisateur anonyme
  name             String? // nom du compte Google, mis à jour à chaque connexion
  image            String? // avatar du compte Google, mis à jour à chaque connexion
  googleSub        String?          @unique // identifiant stable du compte Google (claim « sub »)
  // Arrivée du joueur (src/lib/arrival.ts, src/auth/acquisition.ts), écrite à sa création, ou reprise de l'utilisateur
  // anonyme qu'un compte Google créé à la connexion absorbe ; null pour un utilisateur d'avant le suivi des arrivées.
  source           String? // ref (sinon utm_source) de sa première page publique, sinon domaine du site référent, sinon « direct » (cookie lw_src) ; null sans ce cookie
  referrerDomain   String? // domaine du site référent de sa première visite, jamais son adresse
  landingPage      String? // adresse de sa première page publique : « / », « /fr/defi »
  locale           String? // sa langue à sa création : « fr » ou « en »
  device           DeviceKind? // téléphone ou ordinateur, déduit du navigateur, dont rien n'est gardé
  // Premiers pas du joueur (src/db/activation.ts), à l'horloge de la base, écrits une fois dans la transaction qui les
  // fait ; gardés ici, ses parties pouvant partir (supprimées, purgées) et aucune table ne datant un match ; null tant
  // qu'il ne les a pas faits, ou pour ceux d'avant leur suivi.
  firstSaveAt      DateTime? // création de sa première carrière, défi compris
  firstMatchAt     DateTime? // premier match d'un club qu'il dirige joué, en direct ou simulé
  firstLiveMatchAt DateTime? // premier match d'un club qu'il dirige joué en direct jusqu'au bout (suivi depuis le 17/11/2026)
  firstSeasonEndAt DateTime? // première saison jouée jusqu'à son dernier match, toutes compétitions de la partie
  saves            Save[]
  days             UserDay[]
  challengeEntries ChallengeEntry[]
  resumeLinks      ResumeLink[]
  missions         DailyMission[]

  @@index([createdAt]) // les nouveaux joueurs d'une période (/admin)
}

// Un lien de reprise (src/db/resume-links.ts) : les carrières d'un joueur sans compte rouvertes dans un autre navigateur,
// celui de son téléphone quand il a commencé dans le navigateur d'une appli (Instagram…), où Google ne se connecte pas.
// Le jeton n'est que dans le lien : la base n'en garde que l'empreinte. Valable 7 jours, une seule fois ; supprimé avec
// son utilisateur.
model ResumeLink {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique // SHA-256 du jeton, en hexadécimal
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime? // l'ouverture qui l'a consommé ; null tant qu'il n'a pas servi

  @@index([userId, createdAt]) // les liens récents d'un joueur (plafond par heure), et la suppression en cascade
}

// Un jour où l'utilisateur est venu : écrit au même endroit que lastSeenAt, au plus une fois par jour, pour la
// rétention (/admin/stats). Supprimé avec l'utilisateur.
model UserDay {
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  day    DateTime @db.Date // jour UTC

  @@id([userId, day])
  @@index([day]) // les joueurs actifs d'un jour (/admin)
}

// La mission du jour d'un joueur (src/db/missions.ts) : une par jour UTC, tirée du jour et du joueur
// (src/lib/missions.ts), la même dans toutes ses carrières sauf celles du défi ; écrite quand elle est montrée ou qu'elle
// avance, avec sa progression et, une fois accomplie, la série qu'elle fait. Rien du jeu ne la lit. Supprimée avec
// l'utilisateur.
model DailyMission {
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  day         DateTime    @db.Date // jour UTC
  kind        MissionKind
  target      Int // fois où son action doit avoir lieu
  progress    Int         @default(0) // jamais au-delà de target
  createdAt   DateTime    @default(now()) // proposée : montrée, ou avancée avant d'être montrée
  completedAt DateTime? // à l'horloge de la base ; null tant qu'elle n'est pas accomplie
  streak      Int? // jours d'affilée avec une mission accomplie, celle-ci comprise ; null tant qu'elle ne l'est pas
  best        Int? // le record du joueur à son accomplissement, celle-ci comprise

  @@id([userId, day])
  @@index([day]) // les missions d'une période et les séries en cours (/admin)
}

// Premières visites des pages publiques (proxy.ts, src/db/visits.ts) : des totaux par jour UTC, source et page
// d'arrivée, sans donnée personnelle, pour le passage de la visite à la carrière (/admin). Jamais supprimés.
model VisitDay {
  day    DateTime @db.Date // jour UTC
  source String // comme User.source ; « (other) » au-delà de MAX_VISIT_SOURCES_PER_DAY sources dans la journée
  page   String // adresse de la page d'arrivée : « / », « /fr/defi »
  visits Int

  @@id([day, source, page])
}

// Une ligne par jour UTC des chiffres que rien d'autre ne garde (/admin) : les matchs que jouent les joueurs, en direct
// ou simulés (src/db/daily-stats.ts), puis, à la maintenance du jour, la taille de la base et ce que la purge a supprimé.
model DailyStat {
  day                  DateTime @id @db.Date // jour UTC
  liveMatches          Int      @default(0) // matchs d'un club dirigé joués en direct jusqu'au bout
  simulatedMatches     Int      @default(0) // matchs d'un club dirigé simulés
  databaseBytes        BigInt? // taille de la base à la dernière purge du jour ; null sans purge ce jour-là
  purgedUsers          Int      @default(0) // joueurs sans compte supprimés par la purge
  purgedSaves          Int      @default(0) // leurs parties
  purgedOneDayUsers    Int      @default(0) // dont ceux vus le seul jour de leur création, supprimés après 14 jours
  purgedOneDaySaves    Int      @default(0) // leurs parties : une carrière jamais reprise
  purgedChallengeSaves Int      @default(0) // parties de défi supprimées 24 h après leur semaine
  appLaunches          Int      @default(0) // lancements de l'appli installée (affichage standalone), un par session de l'appli
}

// Les erreurs du jeu, regroupées par jour UTC et par empreinte (source, sorte, route et message aux nombres effacés,
// errorFingerprint, src/lib/error-report.ts) : un compteur, la dernière heure et l'échantillon le plus récent, sans donnée
// personnelle ni cookie (src/db/errors.ts). Du serveur (onRequestError, instrumentation.ts) et des navigateurs
// (POST /api/client-errors). Supprimées au-delà de 30 jours par la maintenance quotidienne (purgeOldErrors).
model ErrorDay {
  day         DateTime    @db.Date // jour UTC
  fingerprint String // empreinte du groupe ; « (other) » d'une source au-delà de MAX_ERROR_GROUPS_PER_DAY groupes dans la journée
  source      ErrorSource
  kind        String // render, route, action, proxy (serveur) ; error, rejection, react (navigateur)
  route       String // la route (« /saves/[id]/live »), jamais l'adresse et ses identifiants
  message     String // le message de la dernière : nom et message, nettoyés (adresses, identifiants, nombres longs), tronqués
  digest      String? // le digest de Next d'une erreur serveur, qui la retrouve dans les journaux de l'hébergeur
  count       Int         @default(1)
  lastSeenAt  DateTime // la dernière, à l'horloge de la base

  @@id([day, fingerprint])
}

// Les passages du nettoyage des événements que plus aucun écran ne lit (src/db/event-cleanup.ts), un par appel de
// POST /api/maintenance/cleanup : un comptage (dryRun) ou une suppression par lots, les lignes supprimées et celles qui
// restent de chaque sorte, sa durée. Sans donnée de joueur ni de partie ; lus par la section Santé de /admin.
model CleanupPass {
  id                     String   @id @default(cuid())
  at                     DateTime @default(now()) // à l'horloge de la base
  dryRun                 Boolean // un comptage : rien n'est supprimé
  otherGoalsDeleted      Int // buts des matchs sans le club dirigé gardés en MatchEvent (d'avant Fixture.goalTimes), dates passées
  otherGoalsRemaining    Int
  managedEventsDeleted   Int // événements des matchs du club dirigé, saisons terminées
  managedEventsRemaining Int
  decisionsDeleted       Int // décisions des matchs du club dirigé (MatchDecision), saisons terminées
  decisionsRemaining     Int
  milliseconds           Int // durée du passage, comptage compris

  @@index([at])
}

model Save {
  id             String              @id @default(cuid())
  owner          User?               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String? // null = partie « héritée », d'avant les propriétaires, rattachée plus tard au compte administrateur
  name           String
  managerName    String
  seed           String // graine de tout l'aléatoire de la partie
  worldVersion   Int // monde de la partie : 1 = premières divisions seules (parties d'avant les deuxièmes), 2 = premières et deuxièmes divisions ; sans défaut, createSave le donne toujours
  currentDate    DateTime // date "en jeu", jamais l'horloge système
  liveFixtureId  String? // match du club dirigé en suspens à la mi-temps ; sans clé étrangère, pour ne pas croiser la cascade depuis Save
  challenge      Challenge?          @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  challengeId    String? // partie du défi de la semaine (graine, club et nom imposés, hors des limites de parties, purgée 24 h après la fin du défi) ; null pour une partie normale
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  clubSaves      ClubSave[]
  playerSaves    PlayerSave[]
  seasons        Season[]
  fixtures       Fixture[]
  transfers      Transfer[]
  stats          PlayerSeasonStats[]
  seasonResults  SeasonResult[]
  seasonBudgets  SeasonBudget[]
  objectives     SeasonObjective[]
  challengeEntry ChallengeEntry?
  seasonArchives SeasonArchive[]

  @@index([ownerId])
  @@index([challengeId])
}

model Season {
  id            String              @id @default(cuid())
  save          Save                @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId        String
  competition   Competition         @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  competitionId String
  startYear     Int // 2026 pour la saison 2026/27
  completed     Boolean             @default(false)
  movements     Json? // montées et descentes à la fin de la saison, clubs quittant cette compétition (src/db/promotion.ts, validé par Zod) ; null dans une partie worldVersion 1 et pour une saison en cours
  fixtures      Fixture[]
  stats         PlayerSeasonStats[]
  results       SeasonResult[] // au plus une : @@unique([saveId, seasonId])
  budget        SeasonBudget? // la dotation du club dirigé, sur sa saison de championnat
  objectives    SeasonObjective[] // les objectifs du club dirigé, sur sa saison de championnat
  archive       SeasonArchive? // ses matchs et statistiques au format compact, une fois terminée et archivée

  @@unique([saveId, competitionId, startYear]) // sert aussi les lectures et la cascade par saveId
}

// Les matchs et les statistiques d'une saison terminée, au format compact (chantier « archives », 10/11) : écrite par la
// tâche de maintenance « archive » (src/db/season-archiving.ts), lue dès qu'elle existe à la place des lignes Fixture et
// PlayerSeasonStats de sa saison (src/db/season-archive.ts), que la même tâche supprime ensuite, par lots, après les
// avoir comparées à l'archive. Tableaux d'entiers de longueur fixe par ligne, codés et décodés par
// src/lib/season-archive.ts. Les identifiants des lignes et les événements et décisions des matchs (MatchEvent,
// MatchDecision, cibles du nettoyage, que plus aucun écran ne lit pour une saison terminée) ne sont pas gardés.
model SeasonArchive {
  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId      String   @id
  save          Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId        String
  version       Int // format du codage (SEASON_ARCHIVE_VERSION)
  clubSaveIds   String[] // les clubs de ses matchs, triés : leur index dans cette liste code un club
  fixtures      Int[] // FIXTURE_FIELDS entiers par match, dans l'ordre (date, tour, domicile, extérieur)
  goalTimes     Int[] // les temps de buts de ses matchs (Fixture.goalTimes), à la suite, dans le même ordre
  instructions  Json? // les consignes des matchs du club dirigé, [index du match, Fixture.instructions] ; null sans aucune
  playerSaveIds String[] // les joueurs de ses statistiques, triés : leur index code un joueur
  stats         Int[] // STAT_FIELDS entiers par ligne de statistiques, dans l'ordre des joueurs
  fixtureCount  Int
  statCount     Int
  managedPlayed Int // matchs joués du club dirigé dans la saison : premiers pas, /admin/stats
  createdAt     DateTime @default(now()) // à l'horloge de la base : ses lignes ne sont supprimées qu'ARCHIVE_DELETE_AFTER_MS après

  @@index([saveId])
}

// Les passages de la tâche « archive » (src/db/season-archiving.ts), un par appel de POST /api/maintenance/archive : un
// comptage, un archivage sans suppression, ou un archivage suivi de la suppression des lignes archivées, par lots. Sans
// donnée de joueur ni de partie ; lus par la section Santé de /admin.
model ArchivePass {
  id               String          @id @default(cuid())
  at               DateTime        @default(now()) // à l'horloge de la base
  mode             ArchivePassMode
  seasonsArchived  Int // saisons archivées par ce passage
  seasonsPending   Int // saisons terminées encore sans archive après lui (parties de défi exclues)
  seasonsDeleted   Int // saisons dont il a supprimé les lignes
  fixturesDeleted  Int
  statsDeleted     Int
  seasonsDeletable Int // saisons archivées dont des lignes restent après lui
  rowsRemaining    Int // ces lignes, matchs et statistiques
  mismatches       Int // saisons laissées en lignes : impossibles à coder, ou différentes de leur archive ; jamais supprimées
  milliseconds     Int // durée du passage, comptage compris

  @@index([at])
}

model ClubSave {
  id              String       @id @default(cuid())
  save            Save         @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId          String
  club            Club         @relation(fields: [clubId], references: [id], onDelete: Restrict)
  clubId          String
  competition     Competition  @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  competitionId   String // compétition actuelle du club dans la partie, Club.competitionId à la création ; une saison passée lit ses clubs dans ses Fixture
  isManaged       Boolean      @default(false) // le club dirigé par le joueur
  budget          Int          @default(0) // euros
  wageBudget      Int          @default(0) // euros par saison
  reputation      Int          @default(50) // 1–99
  boardConfidence Int          @default(50) // 1–99
  formation       String       @default("4-3-3") // dispositif, l'un de FORMATION_NAMES (src/engine/formations.ts) ; pour un club IA d'un autre pays que le club dirigé, celui qu'il garde jusqu'à la fin de formationMonth
  formationMonth  Int? // mois du jeu (année × 100 + mois, UTC) où un club IA d'un autre pays que le club dirigé a choisi formation (monthlyFormation) ; null : jamais choisi ainsi
  lineup          Json? // composition enregistrée du club dirigé : { starters: [{ slot, playerKey }], benchOrder }
  players         PlayerSave[]
  homeFixtures    Fixture[]    @relation("HomeFixtures")
  awayFixtures    Fixture[]    @relation("AwayFixtures")
  wonFixtures     Fixture[]    @relation("WonFixtures")

  @@unique([saveId, clubId]) // sert aussi les lectures et la cascade par saveId
  @@index([saveId, competitionId])
  @@index([saveId, isManaged]) // le club dirigé, lu par presque chaque écran : une ligne, pas les 198 de la partie
  @@index([saveId, reputation]) // le marché : les clubs par réputation (acheteurs, propositions)
}

model PlayerSave {
  id                     String              @id @default(cuid())
  save                   Save                @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId                 String
  // clé stable dans la partie, qui dit aussi l'origine dans le monde du seed : "olympique-lyonnais#5" (Player du club
  // initial et de son squadSlot), "free-agents#12" (vivier), "youth:2027:olympique-lyonnais:1" (jeune arrivé en cours de partie)
  playerKey              String
  firstName              String // identité copiée depuis Player à la création de partie, ou tirée pour un jeune
  lastName               String
  birthDate              DateTime
  nationality            String
  position               Position
  clubSave               ClubSave?           @relation(fields: [clubSaveId], references: [id], onDelete: NoAction)
  clubSaveId             String? // null = joueur libre ou retraité
  retired                Boolean             @default(false) // retraité (transfert RETIREMENT) : sans club pour toujours, jamais un joueur libre
  overall                Int // 1–99, note courante
  potential              Int // 1–99, plafond estimé
  pace                   Int
  shooting               Int
  passing                Int
  dribbling              Int
  defending              Int
  physical               Int
  goalkeeping            Int                 @default(1)
  form                   Int                 @default(50) // 1–99
  morale                 Int                 @default(50) // 1–99
  fitness                Int                 @default(100) // 0–100
  injuredUntil           DateTime?
  // Discipline (src/engine/discipline.ts) : jaunes par compétition depuis la dernière suspension ou le début de saison, et
  // matchs officiels encore à manquer
  leagueYellows          Int                 @default(0) // 5 suspendent pour le prochain match de championnat
  cupYellows             Int                 @default(0) // 5 suspendent pour le prochain match de coupe
  suspendedMatches       Int                 @default(0) // après un rouge : les prochains matchs officiels du club, toute compétition
  suspendedLeagueMatches Int                 @default(0) // après 5 jaunes en championnat : ses prochains matchs de championnat
  suspendedCupMatches    Int                 @default(0) // après 5 jaunes en coupe : ses prochains matchs de coupe
  marketValue            Int                 @default(0) // euros
  wage                   Int                 @default(0) // euros par saison
  contractUntil          DateTime?
  stats                  PlayerSeasonStats[]
  transfers              Transfer[]
  events                 MatchEvent[]        @relation("MatchEventPlayer")
  relatedEvents          MatchEvent[]        @relation("MatchEventRelatedPlayer")
  decisions              MatchDecision[]

  @@unique([saveId, playerKey])
  @@index([saveId, clubSaveId, retired]) // les joueurs d'un club ; les joueurs libres sans les retraités (freeAgentWhere)
  @@index([clubSaveId]) // vérification NoAction de chaque ClubSave supprimé
  // Le marché : les joueurs par note, triés et paginés par la base, leur salaire lu dans l'index (propositions), et par
  // potentiel (Pépites).
  @@index([saveId, overall, wage])
  @@index([saveId, potential, overall, wage])
}

model Fixture {
  id                String          @id @default(cuid())
  save              Save            @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId            String
  season            Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId          String
  round             Int // numéro de journée ; en coupe, le tour : 1 préliminaire, 2 seizièmes … 6 finale
  scheduledAt       DateTime
  homeClubSave      ClubSave        @relation("HomeFixtures", fields: [homeClubSaveId], references: [id], onDelete: Cascade)
  homeClubSaveId    String
  awayClubSave      ClubSave        @relation("AwayFixtures", fields: [awayClubSaveId], references: [id], onDelete: Cascade)
  awayClubSaveId    String
  played            Boolean         @default(false) // vrai si et seulement si status = PLAYED : un match en suspens n'est pas joué
  status            FixtureStatus   @default(SCHEDULED)
  homeGoals         Int? // score final, null tant que le match n'est pas PLAYED
  awayGoals         Int?
  homeHalfTimeGoals Int? // score de mi-temps ; null pour les matchs joués avant le moteur en deux périodes
  awayHalfTimeGoals Int?
  decidedBy         DecidedBy? // match de coupe joué : en 90 minutes, en prolongation ou aux tirs au but ; null en championnat
  homePenalties     Int? // tirs au but réussis, seulement si decidedBy = PENALTIES
  awayPenalties     Int?
  winnerClubSave    ClubSave?       @relation("WonFixtures", fields: [winnerClubSaveId], references: [id], onDelete: Cascade)
  winnerClubSaveId  String? // qualifié d'un match de coupe joué ; null en championnat
  liveState         Json? // état du moteur du match en suspens (IN_PLAY, HALF_TIME, REGULATION_END ; validé par Zod, src/db/live-state.ts), null sinon
  // Les buts d'un match sans le club dirigé, dans l'ordre du match, pour le score des autres matchs pendant le direct :
  // la minute, + 1000 en prolongation, négative pour l'équipe à l'extérieur (goalTimesOf, src/engine/match.ts). Ses
  // événements ne sont plus écrits ; vide pour un match du club dirigé et pour un match joué avant la colonne, dont les
  // buts restent des MatchEvent.
  goalTimes         Int[]           @default([])
  // Les consignes du club dirigé pendant son match, une à chaque changement de segment avec qui l'a donnée
  // ([{ from, instruction, source }], validées par Zod, instructionSpansSchema) : le fil du direct et la feuille de match.
  // null pour un autre match et pour un match joué avant la colonne.
  instructions      Json?
  events            MatchEvent[]
  decisions         MatchDecision[]

  @@index([saveId, seasonId, round])
  @@index([saveId, scheduledAt])
  // Cascades depuis Season et ClubSave
  @@index([seasonId])
  @@index([homeClubSaveId])
  @@index([awayClubSaveId])
  @@index([winnerClubSaveId])
}

model MatchEvent {
  id                  String         @id @default(cuid())
  fixture             Fixture        @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  fixtureId           String
  minute              Int // 1–90 (+ arrêts de jeu), 91–120 en prolongation ; numéro du tir pendant la séance
  period              EventPeriod    @default(REGULAR) // la minute 92 est un arrêt de jeu en REGULAR, une minute de prolongation en EXTRA_TIME
  type                MatchEventType
  side                MatchSide // équipe de l'événement, fixée au match : le club du joueur peut changer ensuite
  playerSave          PlayerSave?    @relation("MatchEventPlayer", fields: [playerSaveId], references: [id], onDelete: Cascade)
  playerSaveId        String? // buteur, joueur averti ou blessé, entrant d'un remplacement
  relatedPlayerSave   PlayerSave?    @relation("MatchEventRelatedPlayer", fields: [relatedPlayerSaveId], references: [id], onDelete: Cascade)
  relatedPlayerSaveId String? // passeur d'un but, sortant d'un remplacement

  @@index([fixtureId])
  @@index([playerSaveId])
  @@index([relatedPlayerSaveId])
}

/// Les décisions prises sur les événements à choix d'un match du club dirigé (gameplay v1, G4), dans l'ordre du match :
/// gardées après lui pour son fil et sa feuille de match. Une par événement : (fixtureId, sequence) unique.
model MatchDecision {
  id           String       @id @default(cuid())
  fixture      Fixture      @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  fixtureId    String
  sequence     Int // 1, 2, 3… dans le match
  minute       Int // la limite de segments où l'événement est venu : 15, 30, 60, 75 ou 105
  kind         ChoiceKind
  option       ChoiceOption
  assistant    Boolean // le choix de l'adjoint, pris par lui ou par le joueur
  playerSave   PlayerSave?  @relation(fields: [playerSaveId], references: [id], onDelete: Cascade)
  playerSaveId String? // le joueur concerné : tireur choisi, joueur averti, touché ou à bout, capitaine

  @@unique([fixtureId, sequence])
  @@index([playerSaveId])
}

model Transfer {
  id           String       @id @default(cuid())
  save         Save         @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId       String
  playerSave   PlayerSave   @relation(fields: [playerSaveId], references: [id], onDelete: Cascade)
  playerSaveId String
  fromClubId   String? // Club.id ; null = joueur libre ou club hors périmètre
  toClubId     String? // Club.id ; null = fin de carrière
  fee          Int          @default(0) // euros
  type         TransferType
  date         DateTime

  @@index([saveId, date])
  @@index([playerSaveId]) // cascade depuis PlayerSave
}

model PlayerSeasonStats {
  id           String     @id @default(cuid())
  save         Save       @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId       String
  season       Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId     String
  playerSave   PlayerSave @relation(fields: [playerSaveId], references: [id], onDelete: Cascade)
  playerSaveId String
  appearances  Int        @default(0)
  starts       Int        @default(0) // titularisations, comptées depuis les objectifs de saison (gameplay v2, V3)
  minutes      Int        @default(0)
  goals        Int        @default(0)
  assists      Int        @default(0)
  yellowCards  Int        @default(0)
  redCards     Int        @default(0)

  @@unique([saveId, seasonId, playerSaveId]) // sert aussi les lectures par (saveId, seasonId)
  // Cascades depuis PlayerSave et Season
  @@index([playerSaveId])
  @@index([seasonId])
}

// Palmarès : le bilan du club dirigé dans une saison terminée de sa compétition, écrit par advanceToNextSeason avant
// le changement de saison (src/db/season-results.ts). Une saison terminée avant cette table est reconstruite à la
// première lecture, une fois. En Cascade vers Season, comme Fixture : la cascade depuis Save supprime Season avant
// d'atteindre cette table, et PostgreSQL vérifierait Restrict à cette étape.
model SeasonResult {
  id                 String      @id @default(cuid())
  save               Save        @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId             String
  season             Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId           String
  competition        Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  competitionId      String
  rank               Int
  points             Int
  played             Int
  won                Int
  drawn              Int
  lost               Int
  goalsFor           Int
  goalsAgainst       Int
  trophies           String[] // « champion » si rank = 1, « cup » pour la coupe gagnée
  cupRound           Int? // dernier tour de coupe joué (1 préliminaire … 6 finale) ; null sans coupe cette saison
  promoted           Boolean     @default(false) // monté en première division à la fin de la saison ; false pour une ligne reconstruite
  relegated          Boolean     @default(false) // descendu en deuxième division à la fin de la saison ; false pour une ligne reconstruite
  bestPlayerKey      String? // PlayerSave.playerKey ; null si aucun joueur n'a joué BEST_PLAYER_MIN_APPEARANCES matchs
  bestPlayerName     String? // prénom et nom
  bestPlayerPosition Position?
  bestPlayerGoals    Int?
  bestPlayerAssists  Int?
  bestPlayerRating   Float? // note de saison sur 10, une décimale (seasonRating, src/engine/season-result.ts)
  formation          String // dispositif du club dirigé à la fin de la saison
  createdAt          DateTime    @default(now())

  @@unique([saveId, seasonId])
  @@index([seasonId]) // cascade depuis Season
}

// La dotation de la direction au club dirigé pour une saison (gameplay v2, V2), pour la carte Finances de l'onglet Club
// et l'écran de début de saison : écrite à la création de la partie (son budget de départ), puis à chaque passage de
// saison (src/db/season-finances.ts). Les clubs IA reçoivent la leur sans ligne : seuls leurs montants changent.
model SeasonBudget {
  id             String @id @default(cuid())
  save           Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId         String
  season         Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId       String @unique // la saison de championnat du club dirigé qu'elle ouvre
  reputation     Int // la réputation du club à l'ouverture de la saison (1–99)
  reputationRank Int // son rang de réputation dans sa division : la dotation en dépend
  dotation       Int // euros : le budget de création (clubFinances) à ce rang, dans la division de la saison
  coefficient    Int // centièmes : 100 sans objectifs, 70 à 140 selon ceux de la saison écoulée
  carryOver      Int // euros : la moitié du budget non dépensé de la saison écoulée ; 0 à la création
  budget         Int // euros : dotation × coefficient + report, le budget de transferts donné
  wageBudget     Int // euros par saison : le plafond salarial, recalculé comme la dotation, sans coefficient

  @@index([saveId])
}

// Les objectifs de la direction pour une saison du club dirigé (gameplay v2, V3), gardés pour l'historique : le
// classement et la coupe, imposés, et trois objectifs proposés au choix, dont un retenu, par le joueur sur l'écran de
// début de saison ou par l'adjoint au premier match (src/db/objectives.ts). Écrits à l'ouverture de la saison (création
// de la partie, passage de saison) ; leur issue à sa fin. Une partie d'avant eux n'en a qu'à partir de sa saison suivante.
model SeasonObjective {
  id          String            @id @default(cuid())
  save        Save              @relation(fields: [saveId], references: [id], onDelete: Cascade)
  saveId      String
  season      Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId    String // la saison de championnat du club dirigé
  kind        ObjectiveKind
  imposed     Boolean // le classement et la coupe ; les autres sont proposés au choix
  chosen      Boolean           @default(false) // l'objectif au choix retenu
  byAssistant Boolean           @default(false) // retenu par l'adjoint, faute de choix avant le premier match
  variant     String? // classement : TOP, PROMOTION, SURVIVAL ou FINISH (src/engine/objectives.ts)
  target      Int // rang au plus, tour de coupe à atteindre, titularisations, buts marqués au moins, buts encaissés au plus, solde des transferts au moins
  exceed      Int? // le rang ou le tour qui le dépasse (classement, coupe)
  outcome     ObjectiveOutcome? // à la fin de la saison ; null avant, et pour un objectif proposé non retenu

  @@unique([seasonId, kind])
  @@index([saveId])
}

// --------------------------------------------------------------------- DÉFI
// Le défi de la semaine : une graine et un club communs à toutes ses parties. Ni référence ni partie : écrit une fois
// par ensureChallenge (src/db/challenge.ts : route de maintenance du lundi, ou premier chargement de /challenge), jamais
// modifié ni supprimé. Ouvert tant que startsAt ≤ maintenant < endsAt : pas de statut stocké.

model Challenge {
  id               String           @id @default(cuid())
  weekKey          String           @unique // semaine ISO 8601 en UTC, « 2026-W45 » (src/lib/iso-week.ts)
  seed             String // graine de ses parties, HMAC de weekKey (src/lib/challenge-seed.ts) : jamais affichée
  club             Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  clubId           String // club imposé, tiré par drawChallengeClub (src/engine/challenge.ts)
  horizonMatchdays Int // journées de championnat du club qui comptent
  startsAt         DateTime // lundi 00:00 UTC de la semaine
  endsAt           DateTime // lundi suivant 00:00 UTC : une entrée soumise ensuite ne compte pas
  createdAt        DateTime         @default(now())
  saves            Save[]
  entries          ChallengeEntry[]
}

// La participation d'un utilisateur à un défi, une par semaine : créée avec sa partie (createChallengeSave), gardée
// quand la partie est supprimée (saveId à NULL), pour que le classement survive à la purge et qu'on ne recommence pas en
// supprimant sa partie. Score écrit une seule fois, quand le club a joué horizonMatchdays journées de championnat
// (recordChallengeScore) : null jusque-là. Supprimée avec l'utilisateur ; suit la partie à la fusion d'un anonyme.
model ChallengeEntry {
  id              String    @id @default(cuid())
  challenge       Challenge @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  challengeId     String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  save            Save?     @relation(fields: [saveId], references: [id], onDelete: SetNull)
  saveId          String?   @unique // null une fois la partie supprimée, par le joueur ou par la purge
  matchdaysPlayed Int       @default(0) // journées de championnat jouées par le club, jusqu'à horizonMatchdays
  points          Int? // des horizonMatchdays premières journées ; null tant que l'entrée n'est pas soumise
  goalDiff        Int?
  goalsFor        Int?
  submittedAt     DateTime? // heure réelle (UTC) de la soumission : date limite et dernier départage
  createdAt       DateTime  @default(now())

  @@unique([challengeId, userId])
  @@index([userId])
}

// -------------------------------------------------------------------- ENUMS

// Postes précis ; le groupe (GK, DF, MF, FW) se déduit du poste : positionGroup, src/engine/positions.ts.
enum Position {
  GK
  RB
  CB
  LB
  CDM
  CM
  CAM
  RM
  LM
  RW
  LW
  ST
}

/// D'où vient une erreur : le serveur ou le navigateur d'un joueur.
enum ErrorSource {
  SERVER
  CLIENT
}

enum UserKind {
  ANONYMOUS
  REGISTERED
}

enum DeviceKind {
  PHONE
  COMPUTER // une tablette compte comme un ordinateur
}

enum FixtureStatus {
  SCHEDULED
  IN_PLAY // match du club dirigé arrêté entre deux segments, hors des pauses ci-dessous : il attend la suite (Save.liveFixtureId)
  HALF_TIME // première période jouée, le match du club dirigé attend la seconde (Save.liveFixtureId)
  REGULATION_END // match de coupe du club dirigé à égalité après 90 minutes : il attend la prolongation (Save.liveFixtureId)
  PLAYED
}

enum MatchEventType {
  GOAL
  YELLOW_CARD
  RED_CARD
  INJURY
  SUBSTITUTION
  SHOOTOUT_GOAL // tir au but réussi : playerSaveId le tireur, relatedPlayerSaveId le gardien
  SHOOTOUT_MISS
}

enum EventPeriod {
  REGULAR
  EXTRA_TIME
  SHOOTOUT
}

/// Les événements à choix du catalogue v1 (src/engine/choices.ts).
enum ChoiceKind {
  PENALTY // penalty pour le club
  FREE_KICK // coup franc dangereux
  HOTHEAD // joueur averti qui s'énerve
  SCUFFLE // échauffourée
  KNOCK // joueur touché
  EXHAUSTED // joueur à bout
  LEADING // le club mène en fin de match
  CHASING // le club est mené ou à égalité en fin de match
}

/// Les options des événements à choix.
enum ChoiceOption {
  TAKER // le tireur du penalty
  SHOOT // frapper le coup franc
  COMBINE // jouer le coup franc en combinaison
  TAKE_OFF // sortir le joueur
  KEEP // garder le joueur
  CALM // calmer ses joueurs
  PROTEST // protester
  PLAY_ON // laisser jouer le joueur touché
  REPLACE // remplacer le joueur à bout
  DEFEND // fermer le jeu
  ATTACK // attaquer
  STEADY // rester tel quel : la règle de l'adjoint
}

enum CompetitionKind {
  LEAGUE
  CUP
}

enum DecidedBy {
  REGULATION
  EXTRA_TIME
  PENALTIES
}

// Ce que fait un passage de la tâche « archive » (ArchivePass).
enum ArchivePassMode {
  COUNT // compte, n'écrit rien d'autre que son passage
  ARCHIVE // archive les saisons terminées, ne supprime rien
  DELETE // archive, puis supprime les lignes des saisons archivées identiques à leur archive
}

enum MatchSide {
  HOME
  AWAY
}

enum TransferType {
  TRANSFER
  LOAN
  FREE
  RETIREMENT
}

/// Les objectifs de saison du club dirigé (gameplay v2, V3) : le classement et la coupe, imposés ; Jeunesse, Spectacle,
/// Solidité et Bonne gestion, proposés trois par saison, un retenu.
enum ObjectiveKind {
  RANKING
  CUP
  YOUTH
  ENTERTAINMENT
  SOLIDITY
  FINANCES
}

/// L'issue d'un objectif à la fin de la saison.
enum ObjectiveOutcome {
  EXCEEDED
  ACHIEVED
  MISSED
}

/// Les missions du jour (src/lib/missions.ts, MISSION_KINDS) : celles d'un match en direct d'abord. Un nom est gardé avec
/// chaque mission : ne jamais en renommer un.
enum MissionKind {
  PLAY_LIVE
  LIVE_SUBSTITUTION
  LIVE_INSTRUCTION
  LIVE_WIN
  WIN
  CLEAN_SHEET
  PLAY_MATCHES
  START_YOUTH
}
